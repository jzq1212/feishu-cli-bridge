# Feishu App credentials (from Feishu Open Platform)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI CLI to call
CLI_BIN=crush
CLI_TIMEOUT=300
CLI_CWD=
MAX_OUTPUT=8000

# Restrict to specific users (comma-separated open_ids; leave empty for open)
ALLOWED_USERS=
